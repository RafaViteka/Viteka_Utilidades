<Project><PropertyGroup><RuntimeIdentifiers>win-x64</RuntimeIdentifiers><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><Version>0.18.0</Version><Company>Viteka</Company><Product>Viteka Utilidades</Product><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors></PropertyGroup><PropertyGroup Condition="'$(VitekaReview)' == 'true'"><DefineConstants>$(DefineConstants);VITEKA_REVIEW</DefineConstants><BaseIntermediateOutputPath>obj-review/</BaseIntermediateOutputPath><BaseOutputPath>bin-review/</BaseOutputPath><Product>Viteka Utilidades Pruebas</Product></PropertyGroup><PropertyGroup><DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**;**/obj-review/**;**/bin-review/**</DefaultItemExcludes></PropertyGroup></Project>
