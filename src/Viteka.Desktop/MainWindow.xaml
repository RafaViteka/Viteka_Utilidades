<Window x:Class="Viteka.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Viteka Utilidades" Width="1240" Height="820" MinWidth="960" MinHeight="680" WindowStyle="None" Background="#FCFCF8" FontFamily="Segoe UI" Foreground="#05302B">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
<Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
<Border Background="#05302B"><Grid Margin="20,0,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/isotipo-blanco.png" Width="24" Height="24"/><TextBlock Text="Utilidades" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Foreground="White" Background="Transparent" BorderThickness="0" Width="46" Padding="0" Click="MinimizeWindow" AutomationProperties.Name="Minimizar"/><Button Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Foreground="White" Background="Transparent" BorderThickness="0" Width="46" Padding="0" Click="MaximizeWindow" AutomationProperties.Name="Maximizar o restaurar"/><Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="White" Background="Transparent" BorderThickness="0" Width="46" Padding="0" Click="CloseWindow" AutomationProperties.Name="Cerrar"/></StackPanel></Grid></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#05302B" Padding="15,30,15,20"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="14,20,0,0"><TextBlock Text="FARMACIAS VIVAS" Foreground="#A1BEB1" FontSize="10"/><TextBlock Text="Un espacio para tu farmacia" Foreground="#7F9F91" FontSize="10" Margin="0,7,0,0"/></StackPanel><StackPanel><Image Source="Assets/logo-blanco.png" Width="158" Height="54" Stretch="Uniform" Margin="0,0,0,36"/><StackPanel x:Name="NavigationList">
<RadioButton x:Name="HomeNav" Tag="Inicio" Style="{StaticResource NavStyle}" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource IconStyle}"/><AccessText Text="Inicio"/></StackPanel></RadioButton>
<RadioButton Tag="Utilidades" Style="{StaticResource NavStyle}" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource IconStyle}"/><AccessText Text="Utilidades"/></StackPanel></RadioButton>
<RadioButton Tag="Favoritos" Style="{StaticResource NavStyle}" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" Style="{StaticResource IconStyle}"/><AccessText Text="Favoritos"/></StackPanel></RadioButton>
<RadioButton Tag="Actividad" Style="{StaticResource NavStyle}" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource IconStyle}"/><AccessText Text="Actividad"/></StackPanel></RadioButton>
<RadioButton Tag="Configuración" Style="{StaticResource NavStyle}" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource IconStyle}"/><AccessText Text="Configuración"/></StackPanel></RadioButton>
</StackPanel></StackPanel></DockPanel></Border>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="36,30,36,30"><Grid Margin="0,0,0,27"><StackPanel><TextBlock Text="VITEKA / UTILIDADES" Foreground="#0B8069" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="PageTitle" Text="Tu farmacia, más ágil" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Todas tus herramientas, en un mismo lugar." FontSize="14" Margin="0,9,0,0" Foreground="#586A63"/></StackPanel></Grid>
<StackPanel x:Name="CatalogPanel"><Border x:Name="SearchSurface" CornerRadius="9" BorderBrush="#DDE5DD" BorderThickness="1" Background="White" Padding="14,12" Margin="0,0,0,24"><DockPanel><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#6F8378" Margin="0,0,12,0" VerticalAlignment="Center"/><Grid><TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" IsEnabled="False" Padding="0" AutomationProperties.Name="Buscar una utilidad"/><TextBlock Text="Buscar una utilidad…" Foreground="#8A9A91" IsHitTestVisible="False"/></Grid></DockPanel></Border>
<Border Background="White" BorderBrush="#E0E6DC" BorderThickness="1" CornerRadius="16" Padding="32,38"><StackPanel HorizontalAlignment="Center" MaxWidth="480"><Border Background="#EDF3E5" CornerRadius="18" Width="74" Height="74" Margin="0,0,0,22"><TextBlock x:Name="EmptyIcon" Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="31" Foreground="#0B8069" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="EmptyTitle" Text="Tu espacio de trabajo empieza aquí" FontSize="23" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="EmptyDescription" Text="Las nuevas utilidades aparecerán en este espacio. Estamos preparando la base de Viteka Utilidades." FontSize="14" Foreground="#586A63" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
<Grid x:Name="HomeShortcuts" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Tag="Favoritos" Click="OpenSection" HorizontalContentAlignment="Stretch" Padding="22"><StackPanel><TextBlock Text="Favoritos" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Tus accesos, cuando los necesites." Foreground="#586A63" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Button><Button Grid.Column="2" Tag="Actividad" Click="OpenSection" HorizontalContentAlignment="Stretch" Padding="22"><StackPanel><TextBlock Text="Actividad" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Aquí podrás consultar tus operaciones." Foreground="#586A63" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Button></Grid></StackPanel>
<StackPanel x:Name="SettingsPanel" Visibility="Collapsed"><Border Background="White" BorderBrush="#E0E6DC" BorderThickness="1" CornerRadius="14" Padding="26"><StackPanel><TextBlock Text="Tu espacio de trabajo" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Preferencias de este usuario y equipo." Foreground="#586A63" Margin="0,7,0,18"/><CheckBox x:Name="OpenFavorites" Content="Abrir Favoritos al iniciar" Checked="SaveStartPreference" Unchecked="SaveStartPreference"/></StackPanel></Border><Border Background="White" BorderBrush="#E0E6DC" BorderThickness="1" CornerRadius="14" Padding="26" Margin="0,18,0,0"><StackPanel><TextBlock Text="Actualizaciones" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Te avisaremos de las nuevas versiones. Tú decides cuándo actualizar." Foreground="#586A63" TextWrapping="Wrap" Margin="0,7,0,18"/><Button x:Name="UpdateCheckButton" Content="Buscar actualizaciones" Click="CheckUpdates" HorizontalAlignment="Left"/><TextBlock x:Name="UpdateResult" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#586A63"/><Button x:Name="OpenReleaseButton" Content="Revisar publicación en GitHub" Click="OpenRelease" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border><Border Background="#F1F4ED" CornerRadius="12" Padding="22" Margin="0,18,0,0"><StackPanel><TextBlock Text="Conexión a NixFarma" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="La configuraremos después de completar el MVP." Foreground="#586A63" Margin="0,7,0,0"/></StackPanel></Border><Expander Header="Información de la aplicación" Margin="0,22,0,0"><StackPanel Margin="0,12"><TextBlock x:Name="VersionLabel"/><TextBlock x:Name="StorageLocation" TextWrapping="Wrap" Foreground="#586A63" Margin="0,8,0,0"/></StackPanel></Expander></StackPanel>
<TextBlock x:Name="StorageNotice" Foreground="#954020" TextWrapping="Wrap" Margin="0,16,0,0"/>
</StackPanel></ScrollViewer></Grid>
<Border Grid.Row="2" Background="#F1F4F1" BorderBrush="#DDE5DD" BorderThickness="0,1,0,0" Padding="18,7"><DockPanel><TextBlock Text="MVP visual" DockPanel.Dock="Right" Foreground="#718378" FontSize="11"/><StackPanel Orientation="Horizontal"><Ellipse Fill="#8A9A91" Width="8" Height="8" Margin="0,0,8,0"/><TextBlock Text="Sin conexión a NixFarma" Foreground="#718378" FontSize="11"/></StackPanel></DockPanel></Border>
</Grid></Window>
