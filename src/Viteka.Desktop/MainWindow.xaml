<Window x:Class="Viteka.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Viteka Utilidades" Width="1180" Height="780" MinWidth="900" MinHeight="620" Background="#FCFCF8" FontFamily="Segoe UI" Foreground="#05302B">
<Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
<Border Background="#05302B" Padding="20,10"><StackPanel Orientation="Horizontal"><Image Source="Assets/isotipo-blanco.png" Width="25" Height="25"/><TextBlock Text="Utilidades" Foreground="White" FontWeight="SemiBold" Margin="12,1,0,0"/></StackPanel></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#05302B" Padding="18,25"><DockPanel><StackPanel DockPanel.Dock="Top"><Image Source="Assets/logo-blanco.png" Height="60" Stretch="Uniform"/><TextBlock Text="UTILIDADES" Foreground="#B8E36A" FontSize="11" Margin="5,16,0,28"/><Button Content="Inicio" Tag="Inicio" Click="Navigate"/><Button Content="Utilidades" Tag="Utilidades" Click="Navigate"/><Button Content="Favoritos" Tag="Favoritos" Click="Navigate"/><Button Content="Actividad" Tag="Actividad" Click="Navigate"/><Button Content="Configuración" Tag="Configuración" Click="Navigate"/></StackPanel></DockPanel></Border>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="30"><TextBlock x:Name="PageTitle" Text="Tu farmacia, más ágil" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Todas tus herramientas, en un mismo lugar." Margin="0,8,0,24" Foreground="#586A63"/>
<StackPanel x:Name="CatalogPanel"><TextBlock Text="Buscar una utilidad" Margin="0,0,0,5"/><TextBox x:Name="SearchBox" TextChanged="SearchChanged" Padding="12" Margin="0,0,0,18"/><WrapPanel x:Name="UtilityCards"/><TextBlock x:Name="EmptyCatalog" Visibility="Collapsed" Margin="0,18" TextWrapping="Wrap"/></StackPanel>
<StackPanel x:Name="ActivityPanel" Visibility="Collapsed"><TextBlock Text="Actividad local reciente" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Últimas 100 acciones locales de este usuario en este equipo. No es una auditoría de operaciones de farmacia." Margin="0,8,0,18" TextWrapping="Wrap"/><ItemsControl x:Name="ActivityList"/></StackPanel>
<StackPanel x:Name="SettingsPanel" Visibility="Collapsed"><TextBlock Text="Preferencias de este usuario" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="OpenFavorites" Content="Abrir Favoritos al iniciar" Checked="SaveStartPreference" Unchecked="SaveStartPreference" Margin="0,14"/><TextBlock Text="Carpeta local de configuración y actividad:"/><TextBlock x:Name="StorageLocation" TextWrapping="Wrap" Margin="0,8" Foreground="#586A63"/><Separator Margin="0,18"/><TextBlock Text="Vinculación del puesto" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Introduce el código de un solo uso creado por el administrador en el servidor. Caduca en cinco minutos." TextWrapping="Wrap" Margin="0,8"/><PasswordBox x:Name="PairingCode" MaxLength="32" Padding="10"/><Button x:Name="PairButton" Content="Vincular este usuario y equipo" Click="PairDevice" HorizontalAlignment="Left"/><TextBlock x:Name="PairingResult" TextWrapping="Wrap" Margin="0,8"/><Separator Margin="0,18"/><TextBlock Text="Servicio de demostración" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="http://127.0.0.1:5187" Margin="0,10"/><TextBlock Text="Esta versión solo comprueba el servicio local. El acceso desde puestos requiere desplegar autenticación y TLS. No introduzcas contraseñas de Oracle aquí." TextWrapping="Wrap"/><Button x:Name="CheckButton" Content="Comprobar servicio local" Click="CheckService" HorizontalAlignment="Left" Margin="0,20,0,10"/><TextBlock x:Name="ConnectionResult" TextWrapping="Wrap"/><Separator Margin="0,24"/><TextBlock Text="NixFarma: sin configurar · Acceso previsto: solo lectura" TextWrapping="Wrap"/><Separator Margin="0,24"/><TextBlock Text="Actualizaciones" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Canal: GitHub Releases · Avisar y actualizar cuando el administrador lo decida." TextWrapping="Wrap" Margin="0,8"/><Button x:Name="UpdateCheckButton" Content="Buscar actualizaciones" Click="CheckUpdates" HorizontalAlignment="Left"/><TextBlock x:Name="UpdateResult" TextWrapping="Wrap" Margin="0,8"/><Button x:Name="OpenReleaseButton" Content="Revisar publicación en GitHub" Click="OpenRelease" Visibility="Collapsed" HorizontalAlignment="Left"/></StackPanel>
<TextBlock x:Name="StorageNotice" Foreground="#954020" TextWrapping="Wrap" Margin="0,15,0,0"/><Border Background="#EDF3E5" CornerRadius="10" Padding="18" Margin="0,26,0,0"><TextBlock Text="Modo demostración · Utilidades de ejemplo · Sin acceso a datos reales" TextWrapping="Wrap"/></Border>
</StackPanel></ScrollViewer></Grid>
<Border Grid.Row="2" Background="#F1F4F1" Padding="16,7"><TextBlock Text="NixFarma · Sin conectar                                      Prototipo 0.4 · Solo lectura prevista" FontSize="12" Foreground="#586A63"/></Border>
</Grid></Window>
