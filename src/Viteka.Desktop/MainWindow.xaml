<Window x:Class="Viteka.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Viteka Utilidades" Width="1240" Height="820" MinWidth="820" MinHeight="600" Icon="Assets/viteka.ico" ResizeMode="CanResize" WindowStyle="None" Background="#FCFCF8" FontFamily="Segoe UI" Foreground="{DynamicResource ChromeForeground}">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
<Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource ChromeBackground}"><Grid Margin="20,0,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Utilidades" Foreground="{DynamicResource ChromeForeground}" FontSize="14" FontWeight="SemiBold" Margin="0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><StackPanel x:Name="ZoomBar" IsEnabled="False" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><Button Content="−" Width="30" Height="32" Padding="0" Background="Transparent" Foreground="{DynamicResource ChromeForeground}" BorderThickness="0" Click="ZoomOut" AutomationProperties.Name="Reducir zoom"/><Button x:Name="ZoomLabel" Content="100 %" Width="64" Height="32" Padding="0" Background="Transparent" Foreground="{DynamicResource ChromeForeground}" BorderThickness="0" Click="ResetZoom" ToolTip="Ctrl + rueda · Ctrl + 0 para restablecer" AutomationProperties.Name="Restablecer zoom al 100 por ciento"/><Button Content="+" Width="30" Height="32" Padding="0" Background="Transparent" Foreground="{DynamicResource ChromeForeground}" BorderThickness="0" Click="ZoomIn" AutomationProperties.Name="Ampliar zoom"/></StackPanel><Button x:Name="MinimizeButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ChromeForeground}" Background="Transparent" BorderThickness="0" Width="46" Height="48" Padding="0" Click="MinimizeWindow" AutomationProperties.Name="Minimizar"/><Button x:Name="MaximizeButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ChromeForeground}" Background="Transparent" BorderThickness="0" Width="46" Height="48" Padding="0" Click="MaximizeWindow" AutomationProperties.Name="Maximizar o restaurar"/><Button x:Name="CloseButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ChromeForeground}" Background="Transparent" BorderThickness="0" Width="46" Height="48" Padding="0" Click="CloseWindow" AutomationProperties.Name="Cerrar"/></StackPanel></Grid></Border>
<Grid Grid.Row="1"><wv:WebView2 x:Name="Browser" DefaultBackgroundColor="#FCFCF8"/><Border x:Name="LoadingPanel" Background="#FCFCF8" Padding="40"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540"><TextBlock Text="Viteka Utilidades" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="LoadingMessage" Text="Preparando tu espacio de trabajo…" FontSize="14" Foreground="#586A63" Margin="0,15,0,20" TextWrapping="Wrap"/><Button x:Name="RuntimeHelp" Content="Instalar Microsoft Edge WebView2" Click="OpenRuntimeHelp" Visibility="Collapsed"/></StackPanel></Border></Grid></Grid></Window>